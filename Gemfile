source "https://rubygems.org"

# Keep local builds aligned with GitHub Pages' supported Jekyll stack.
gem "github-pages", group: :jekyll_plugins

# The system Ruby shipped with this macOS supports the Ruby-platform ffi gem,
# but not the newest native macOS build. GitHub Pages itself resolves ffi.
gem "ffi", "~> 1.15.5"
gem "json", "2.3.0"
